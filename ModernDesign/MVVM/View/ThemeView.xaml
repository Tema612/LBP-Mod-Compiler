<UserControl x:Class="ModernDesign.MVVM.View.ThemeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ModernDesign.MVVM.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style TargetType="{x:Type Button}" x:Key="Button1">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <!-- The Border provides the CornerRadius -->
                        <Border CornerRadius="15" 
                            Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <!-- ContentPresenter displays the button text/content -->
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Button Margin="75,62,377,260" Click="Button_Click" Style="{DynamicResource Button1}">
            <Button.Background>
                <ImageBrush ImageSource="/Images/lbp1.png"></ImageBrush>
            </Button.Background>
            <TextBlock Text="LBP1" FontSize="22" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="/Fonts/#Crikey Squat" RenderTransformOrigin="-0.018,-0.082" Foreground="White" Margin="-60"/>
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="20"></Setter>
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="PreviewMouseDown">
                            <SoundPlayerAction Source="/Select.wav"></SoundPlayerAction>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Resources>
        </Button>
        <Button Margin="75,246,377,76" Style="{DynamicResource Button1}" Click="Button_Click_2">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="20"/>
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="UIElement.PreviewMouseDown">
                            <SoundPlayerAction Source="/Select.wav"/>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Resources>
            <Button.Background>
                <ImageBrush ImageSource="/LittleBigPlanet Mod Compiler;component/Images/lbp2.png"/>
            </Button.Background>
            <TextBlock Text="LBP2" FontSize="22" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="/Fonts/#Crikey Squat" RenderTransformOrigin="-0.018,-0.082" Foreground="White" Margin="-60"/>
        </Button>
        <Button Margin="398,74,10,260" Style="{DynamicResource Button1}" Click="Button_Click_1">
            <Button.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="20"/>
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="UIElement.PreviewMouseDown">
                            <SoundPlayerAction Source="/Select.wav"/>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Resources>
            <Button.Background>
                <ImageBrush ImageSource="/LittleBigPlanet Mod Compiler;component/Images/lbp3.png"/>
            </Button.Background>
            <TextBlock Text="LBP3" FontSize="22" HorizontalAlignment="Left" VerticalAlignment="Top" FontFamily="/Fonts/#Crikey Squat" RenderTransformOrigin="-0.018,-0.082" Foreground="White" Margin="-70"/>
        </Button>
    </Grid>
</UserControl>
