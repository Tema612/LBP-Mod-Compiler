<UserControl x:Class="ModernDesign.MVVM.View.ConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ModernDesign.MVVM.View"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>

    </UserControl.Resources>



    <Grid>
        <TextBlock Text="Config Editor"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       Foreground="White"
                       FontSize="22"
                       FontFamily="/Fonts/#Eigerdals Heavy"></TextBlock>

        <avalonEdit:TextEditor 
        Name="textEditor"
        FontFamily="Consolas"
        FontSize="10pt"
        ShowLineNumbers="True" Margin="145,0,0,0"/>

        <Button Content="Open"
                Foreground="White"
                FontSize="22" Margin="10,416,602,22" Click="Button_Click" Style="{StaticResource RoundedButtonStyle}">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,2">
                    <GradientStop Color="DarkGreen" Offset="0"></GradientStop>
                    <GradientStop Color="LightGreen" Offset="1"></GradientStop>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="20"></Setter>
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="PreviewMouseDown">
                            <SoundPlayerAction Source="/Select.wav"></SoundPlayerAction>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Resources>
        </Button>
        <Button Content="Save"
            Foreground="White"
            FontSize="22" Margin="10,314,602,124" Click="Button_Click_1" Style="{StaticResource RoundedButtonStyle}">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,2">
                    <GradientStop Color="LightSteelBlue" Offset="0"></GradientStop>
                    <GradientStop Color="Blue" Offset="1"></GradientStop>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="20"></Setter>
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="PreviewMouseDown">
                            <SoundPlayerAction Source="/Select.wav"></SoundPlayerAction>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Resources>
        </Button>


    </Grid>
</UserControl>
