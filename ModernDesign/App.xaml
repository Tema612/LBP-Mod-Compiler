<Application
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ModernDesign"
			 xmlns:view="clr-namespace:ModernDesign.MVVM.View"
			 xmlns:viewModel="clr-namespace:ModernDesign.MVVM.ViewModel"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/EditorButton.xaml"></ResourceDictionary>
                <ResourceDictionary Source="Theme/MenuButton.xaml"></ResourceDictionary>
                <ResourceDictionary Source="Theme/MenuButton-LBP2.xaml"></ResourceDictionary>
                <ResourceDictionary Source="Theme/MenuButton-LBP3.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type viewModel:HomeViewModel}">
                <view:HomeView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModel:ConfigViewModel}">
                <view:ConfigView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModel:ThemeViewModel}">
                <view:ThemeView></view:ThemeView>
            </DataTemplate>


        </ResourceDictionary>


    </Application.Resources>
</Application>
